# Copy to infra/.env (gitignored) and fill in after infra/SETUP.md.
R2_BUCKET=ratmap-tiles
R2_ACCOUNT_ID=
R2_PUBLIC_URL=https://pub-xxxxxxxx.r2.dev

# Only if the bucket was created with a data-location jurisdiction: eu | fedramp | us.
# Leave unset for Automatic. Wrong/missing value = 403 AccessDenied on everything, see
# SETUP.md step 1.3.
R2_JURISDICTION=

# From R2 -> Manage R2 API Tokens (the Access Key ID / Secret pair, NOT the "Token value"
# on that same screen — that one is for Cloudflare's REST API, not the S3-compatible one).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
