# Copy to .env.local to override tile/data sources. Defaults (src/config.ts) already point
# at our own R2 bucket, so none of this is required for normal development.

# Swap the whole bucket at once — Phase 3 uses this to move off the .r2.dev dev URL.
# VITE_R2_BASE_URL=https://tiles.example.com

# Or override individual artifacts.
# VITE_BASEMAP_PMTILES_URL=https://tiles.example.com/world-catalog-YYYY-MM-DD.pmtiles
# VITE_TERRAIN_PMTILES_URL=https://tiles.example.com/terrain-global-YYYY-MM-DD.pmtiles
# VITE_PEAKS_PMTILES_URL=https://tiles.example.com/peaks-global.pmtiles

# Fall back to AWS Open Data terrarium tiles instead of our terrain archive. Useful to
# isolate "is the bug in our archive or in MapLibre?" when hillshade misbehaves.
# VITE_USE_FALLBACK_TERRAIN=1
# VITE_FALLBACK_TERRAIN_URL=https://s3.amazonaws.com/elevation-tiles-prod/terrarium/{z}/{x}/{y}.png
