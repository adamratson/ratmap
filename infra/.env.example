# Copy to infra/.env (gitignored) and fill in after infra/SETUP.md.
S3_BUCKET=ratmap-tiles
S3_ENDPOINT=https://uk-lon-1.katapultobjects.com
S3_REGION=uk-lon-1
PUBLIC_BASE_URL=https://ratmap-tiles.uk-lon-1.katapultobjects.com

# From the Katapult console: Object Storage -> your bucket -> Access Keys -> Create.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
